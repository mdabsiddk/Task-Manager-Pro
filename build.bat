@echo off
:: ============================================================
::  Task Manager Pro - Build script
::  Compiles src\**\*.cs into build\TaskManagerPro.exe with the
::  C# compiler that ships with Windows (.NET Framework 4.x).
::  No Visual Studio or SDK needed.   Usage: build.bat [/quiet]
::
::  The version comes from the VERSION file (one place for the
::  whole project) and is stamped into the program file here.
:: ============================================================
setlocal EnableExtensions
set "ROOT=%~dp0"
set "OUT_DIR=%ROOT%build"
set "OUT_EXE=%OUT_DIR%\TaskManagerPro.exe"

set "CSC=%WINDIR%\Microsoft.NET\Framework64\v4.0.30319\csc.exe"
if not exist "%CSC%" set "CSC=%WINDIR%\Microsoft.NET\Framework\v4.0.30319\csc.exe"
if not exist "%CSC%" (
    echo [X] .NET Framework 4.x C# compiler ^(csc.exe^) was not found.
    echo     Enable ".NET Framework 4.8" in "Turn Windows features on or off".
    goto :fail
)

set "APP_VERSION="
if exist "%ROOT%VERSION" for /f "usebackq delims=" %%v in ("%ROOT%VERSION") do if not defined APP_VERSION set "APP_VERSION=%%v"
echo(%APP_VERSION%| findstr /r /x "[0-9][0-9]*\.[0-9][0-9]*\.[0-9][0-9]*" >nul || (
    echo [X] The VERSION file must contain a version like 2.3.0 ^(found "%APP_VERSION%"^).
    goto :fail
)

if not exist "%OUT_DIR%\obj" mkdir "%OUT_DIR%\obj"
set "VERSION_CS=%OUT_DIR%\obj\Version.g.cs"
> "%VERSION_CS%" echo // Generated by build.bat from the VERSION file. Do not edit.
>>"%VERSION_CS%" echo using System.Reflection;
>>"%VERSION_CS%" echo [assembly: AssemblyVersion("%APP_VERSION%.0")]
>>"%VERSION_CS%" echo [assembly: AssemblyFileVersion("%APP_VERSION%.0")]
>>"%VERSION_CS%" echo [assembly: AssemblyInformationalVersion("%APP_VERSION%")]

echo [*] Compiling Task Manager Pro %APP_VERSION%...
"%CSC%" -nologo -target:winexe -optimize+ -platform:anycpu -warn:4 ^
    -out:"%OUT_EXE%" ^
    -win32manifest:"%ROOT%src\app.manifest" ^
    -win32icon:"%ROOT%assets\app.ico" ^
    -r:System.dll -r:System.Core.dll -r:System.Drawing.dll -r:System.Windows.Forms.dll -r:System.IO.Compression.dll -r:System.IO.Compression.FileSystem.dll ^
    -recurse:"%ROOT%src\*.cs" "%VERSION_CS%"
if errorlevel 1 (
    echo [X] Build failed.
    goto :fail
)
copy /Y "%ROOT%src\app.config" "%OUT_EXE%.config" >nul

echo [OK] Built: %OUT_EXE% ^(version %APP_VERSION%^)
if /i not "%~1"=="/quiet" pause
exit /b 0

:fail
if /i not "%~1"=="/quiet" pause
exit /b 1
