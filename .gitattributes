# Auto detect text files and perform LF normalization
* text=auto

# Windows scripts must keep CRLF line endings (labels/goto in .bat files break with LF),
# also in GitHub's source ZIP downloads.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary files
*.ico binary
*.png binary
*.exe binary
*.zip binary
