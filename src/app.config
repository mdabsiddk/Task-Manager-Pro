<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.5" />
  </startup>
  <runtime>
    <!-- No background GC thread and a smaller heap: keeps the always-running engine light. -->
    <gcConcurrent enabled="false" />
    <gcServer enabled="false" />
    <!-- Don't load the .NET Framework's publisher policy probes we don't need. -->
    <generatePublisherEvidence enabled="false" />
  </runtime>
</configuration>
